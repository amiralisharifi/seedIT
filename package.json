{
  "name": "seed-panel",
  "version": "0.1.0",
  "private": true,
  "description": "A schema-driven admin panel & CMS for outbound businesses. Cloneable per deployment.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:generate": "turbo run db:generate --filter=@seed-panel/db",
    "db:migrate": "turbo run db:migrate --filter=@seed-panel/db",
    "db:studio": "turbo run db:studio --filter=@seed-panel/db",
    "db:seed": "turbo run db:seed --filter=@seed-panel/db",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
